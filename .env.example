# ─── Neon PostgreSQL ───────────────────────────────────────────────────────────
# In the Neon dashboard (Project → Connect):
#   • "Pooled connection"  → DATABASE_URL  (hostname contains -pooler)
#   • "Direct connection"  → DIRECT_URL    (no -pooler in hostname)
#
# Both URLs must include ?sslmode=require (Neon adds this by default).

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js / NextAuth v5 ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Auth.js v5 reads AUTH_SECRET. NEXTAUTH_SECRET is accepted as a fallback.
AUTH_SECRET="your-random-secret-here"

# Canonical production URL — required for stable OAuth cookies on Vercel.
AUTH_URL="https://giswap.vercel.app"

# Optional: enable Google sign-in from Vercel preview deploys.
# Must match the redirect URI registered in Google Cloud Console.
# AUTH_REDIRECT_PROXY_URL="https://giswap.vercel.app/api/auth"

# Google OAuth — add this redirect URI in Google Cloud Console:
#   https://giswap.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── UploadThing (image uploads) ───────────────────────────────────────────────
UPLOADTHING_TOKEN="your-uploadthing-token"

# ─── Pusher (real-time messaging) ──────────────────────────────────────────────
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# ─── Admin moderation ──────────────────────────────────────────────────────────
# Comma-separated list of email addresses with admin access to /admin/reports
ADMIN_EMAILS="admin@yourdomain.com"

# ─── App URL (used for share links and SEO metadata) ───────────────────────────
NEXT_PUBLIC_APP_URL="https://giswap.vercel.app"
